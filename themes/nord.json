{
  "schemaVersion": 1,
  "base": "dark",
  "tokens": {
    "--background": "#3b4252",
    "--foreground": "#eceff4",
    "--primary": "#88c0d0",
    "--primary-foreground": "#2e3440"
  },
  "tokenColors": [
    {
      "name": "comment",
      "scope": [
        "comment"
      ],
      "settings": {
        "foreground": "#8692a8",
        "fontStyle": "italic"
      }
    },
    {
      "name": "delimiter",
      "scope": [
        "keyword",
        "storage",
        "constant.language",
        "variable.language"
      ],
      "settings": {
        "foreground": "#81a1c1"
      }
    },
    {
      "name": "control",
      "scope": [
        "keyword.control"
      ],
      "settings": {
        "foreground": "#b48ead"
      }
    },
    {
      "name": "operator",
      "scope": [
        "keyword.operator"
      ],
      "settings": {
        "foreground": "#81a1c1"
      }
    },
    {
      "name": "variable",
      "scope": [
        "support.variable",
        "variable.parameter"
      ],
      "settings": {
        "foreground": "#88c0d0"
      }
    },
    {
      "name": "filter",
      "scope": [
        "entity.name.type",
        "support.type",
        "support.class"
      ],
      "settings": {
        "foreground": "#ebcb8b"
      }
    },
    {
      "name": "function",
      "scope": [
        "entity.name.function",
        "support.function",
        "meta.decorator"
      ],
      "settings": {
        "foreground": "#8fbcbb"
      }
    },
    {
      "name": "string",
      "scope": [
        "string",
        "markup.inline.raw"
      ],
      "settings": {
        "foreground": "#a3be8c"
      }
    },
    {
      "name": "escape",
      "scope": [
        "constant.character.escape",
        "string.regexp"
      ],
      "settings": {
        "foreground": "#ebcb8b"
      }
    },
    {
      "name": "number",
      "scope": [
        "constant.numeric",
        "constant"
      ],
      "settings": {
        "foreground": "#d08770"
      }
    },
    {
      "name": "tag",
      "scope": [
        "entity.name.tag",
        "markup.heading"
      ],
      "settings": {
        "foreground": "#81a1c1"
      }
    },
    {
      "name": "attribute",
      "scope": [
        "entity.other.attribute-name"
      ],
      "settings": {
        "foreground": "#8fbcbb",
        "fontStyle": "italic"
      }
    },
    {
      "name": "property",
      "scope": [
        "support.type.property-name"
      ],
      "settings": {
        "foreground": "#88c0d0"
      }
    },
    {
      "name": "link",
      "scope": [
        "markup.underline.link"
      ],
      "settings": {
        "foreground": "#88c0d0",
        "fontStyle": "underline"
      }
    },
    {
      "name": "invalid",
      "scope": [
        "invalid"
      ],
      "settings": {
        "foreground": "#c87d86"
      }
    }
  ]
}

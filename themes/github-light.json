{
  "schemaVersion": 1,
  "base": "light",
  "tokens": {
    "--background": "#ffffff",
    "--foreground": "#1f2328",
    "--primary": "#0969da",
    "--primary-foreground": "#ffffff"
  },
  "tokenColors": [
    {
      "name": "comment",
      "scope": [
        "comment"
      ],
      "settings": {
        "foreground": "#6e7781",
        "fontStyle": "italic"
      }
    },
    {
      "name": "delimiter",
      "scope": [
        "keyword",
        "storage",
        "constant.language",
        "variable.language"
      ],
      "settings": {
        "foreground": "#cf222e"
      }
    },
    {
      "name": "control",
      "scope": [
        "keyword.control"
      ],
      "settings": {
        "foreground": "#8250df"
      }
    },
    {
      "name": "operator",
      "scope": [
        "keyword.operator"
      ],
      "settings": {
        "foreground": "#cf222e"
      }
    },
    {
      "name": "variable",
      "scope": [
        "support.variable",
        "variable.parameter"
      ],
      "settings": {
        "foreground": "#0550ae"
      }
    },
    {
      "name": "filter",
      "scope": [
        "entity.name.type",
        "support.type",
        "support.class"
      ],
      "settings": {
        "foreground": "#953800"
      }
    },
    {
      "name": "function",
      "scope": [
        "entity.name.function",
        "support.function",
        "meta.decorator"
      ],
      "settings": {
        "foreground": "#6639ba"
      }
    },
    {
      "name": "string",
      "scope": [
        "string",
        "markup.inline.raw"
      ],
      "settings": {
        "foreground": "#0a3069"
      }
    },
    {
      "name": "escape",
      "scope": [
        "constant.character.escape",
        "string.regexp"
      ],
      "settings": {
        "foreground": "#116329"
      }
    },
    {
      "name": "number",
      "scope": [
        "constant.numeric",
        "constant"
      ],
      "settings": {
        "foreground": "#0550ae"
      }
    },
    {
      "name": "tag",
      "scope": [
        "entity.name.tag",
        "markup.heading"
      ],
      "settings": {
        "foreground": "#116329"
      }
    },
    {
      "name": "attribute",
      "scope": [
        "entity.other.attribute-name"
      ],
      "settings": {
        "foreground": "#0550ae",
        "fontStyle": "italic"
      }
    },
    {
      "name": "property",
      "scope": [
        "support.type.property-name"
      ],
      "settings": {
        "foreground": "#0550ae"
      }
    },
    {
      "name": "link",
      "scope": [
        "markup.underline.link"
      ],
      "settings": {
        "foreground": "#0969da",
        "fontStyle": "underline"
      }
    },
    {
      "name": "invalid",
      "scope": [
        "invalid"
      ],
      "settings": {
        "foreground": "#82071e"
      }
    }
  ]
}

{
  "schemaVersion": 1,
  "base": "light",
  "tokens": {
    "--background": "#fdf6e3",
    "--foreground": "#586e75",
    "--primary": "#1f72ac",
    "--primary-foreground": "#fdf6e3"
  },
  "tokenColors": [
    {
      "name": "comment",
      "scope": [
        "comment"
      ],
      "settings": {
        "foreground": "#7b8d8f",
        "fontStyle": "italic"
      }
    },
    {
      "name": "delimiter",
      "scope": [
        "keyword",
        "storage",
        "constant.language",
        "variable.language"
      ],
      "settings": {
        "foreground": "#7f9310"
      }
    },
    {
      "name": "control",
      "scope": [
        "keyword.control"
      ],
      "settings": {
        "foreground": "#cb4b16"
      }
    },
    {
      "name": "operator",
      "scope": [
        "keyword.operator"
      ],
      "settings": {
        "foreground": "#7f9310"
      }
    },
    {
      "name": "variable",
      "scope": [
        "support.variable",
        "variable.parameter"
      ],
      "settings": {
        "foreground": "#268bd2"
      }
    },
    {
      "name": "filter",
      "scope": [
        "entity.name.type",
        "support.type",
        "support.class"
      ],
      "settings": {
        "foreground": "#6c71c4"
      }
    },
    {
      "name": "function",
      "scope": [
        "entity.name.function",
        "support.function",
        "meta.decorator"
      ],
      "settings": {
        "foreground": "#a88510"
      }
    },
    {
      "name": "string",
      "scope": [
        "string",
        "markup.inline.raw"
      ],
      "settings": {
        "foreground": "#329892"
      }
    },
    {
      "name": "escape",
      "scope": [
        "constant.character.escape",
        "string.regexp"
      ],
      "settings": {
        "foreground": "#dc322f"
      }
    },
    {
      "name": "number",
      "scope": [
        "constant.numeric",
        "constant"
      ],
      "settings": {
        "foreground": "#d33682"
      }
    },
    {
      "name": "tag",
      "scope": [
        "entity.name.tag",
        "markup.heading"
      ],
      "settings": {
        "foreground": "#268bd2"
      }
    },
    {
      "name": "attribute",
      "scope": [
        "entity.other.attribute-name"
      ],
      "settings": {
        "foreground": "#a88510",
        "fontStyle": "italic"
      }
    },
    {
      "name": "property",
      "scope": [
        "support.type.property-name"
      ],
      "settings": {
        "foreground": "#268bd2"
      }
    },
    {
      "name": "link",
      "scope": [
        "markup.underline.link"
      ],
      "settings": {
        "foreground": "#268bd2",
        "fontStyle": "underline"
      }
    },
    {
      "name": "invalid",
      "scope": [
        "invalid"
      ],
      "settings": {
        "foreground": "#dc322f"
      }
    }
  ]
}

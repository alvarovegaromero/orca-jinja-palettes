{
  "schemaVersion": 1,
  "base": "dark",
  "tokens": {
    "--background": "#282a36",
    "--foreground": "#f8f8f2",
    "--primary": "#bd93f9",
    "--primary-foreground": "#21222c"
  },
  "tokenColors": [
    {
      "name": "comment",
      "scope": [
        "comment"
      ],
      "settings": {
        "foreground": "#6877a7",
        "fontStyle": "italic"
      }
    },
    {
      "name": "delimiter",
      "scope": [
        "keyword",
        "storage",
        "constant.language",
        "variable.language"
      ],
      "settings": {
        "foreground": "#ff79c6"
      }
    },
    {
      "name": "control",
      "scope": [
        "keyword.control"
      ],
      "settings": {
        "foreground": "#bd93f9"
      }
    },
    {
      "name": "operator",
      "scope": [
        "keyword.operator"
      ],
      "settings": {
        "foreground": "#ff79c6"
      }
    },
    {
      "name": "variable",
      "scope": [
        "support.variable",
        "variable.parameter"
      ],
      "settings": {
        "foreground": "#8be9fd"
      }
    },
    {
      "name": "filter",
      "scope": [
        "entity.name.type",
        "support.type",
        "support.class"
      ],
      "settings": {
        "foreground": "#50fa7b"
      }
    },
    {
      "name": "function",
      "scope": [
        "entity.name.function",
        "support.function",
        "meta.decorator"
      ],
      "settings": {
        "foreground": "#50fa7b"
      }
    },
    {
      "name": "string",
      "scope": [
        "string",
        "markup.inline.raw"
      ],
      "settings": {
        "foreground": "#f1fa8c"
      }
    },
    {
      "name": "escape",
      "scope": [
        "constant.character.escape",
        "string.regexp"
      ],
      "settings": {
        "foreground": "#ff79c6"
      }
    },
    {
      "name": "number",
      "scope": [
        "constant.numeric",
        "constant"
      ],
      "settings": {
        "foreground": "#ffb86c"
      }
    },
    {
      "name": "tag",
      "scope": [
        "entity.name.tag",
        "markup.heading"
      ],
      "settings": {
        "foreground": "#ff79c6"
      }
    },
    {
      "name": "attribute",
      "scope": [
        "entity.other.attribute-name"
      ],
      "settings": {
        "foreground": "#50fa7b",
        "fontStyle": "italic"
      }
    },
    {
      "name": "property",
      "scope": [
        "support.type.property-name"
      ],
      "settings": {
        "foreground": "#8be9fd"
      }
    },
    {
      "name": "link",
      "scope": [
        "markup.underline.link"
      ],
      "settings": {
        "foreground": "#8be9fd",
        "fontStyle": "underline"
      }
    },
    {
      "name": "invalid",
      "scope": [
        "invalid"
      ],
      "settings": {
        "foreground": "#ff5555"
      }
    }
  ]
}

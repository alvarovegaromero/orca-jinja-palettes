{
  "schemaVersion": 1,
  "base": "dark",
  "tokens": {
    "--background": "#272822",
    "--foreground": "#f8f8f2",
    "--primary": "#a6e22e",
    "--primary-foreground": "#272822"
  },
  "tokenColors": [
    {
      "name": "comment",
      "scope": [
        "comment"
      ],
      "settings": {
        "foreground": "#7a7664",
        "fontStyle": "italic"
      }
    },
    {
      "name": "delimiter",
      "scope": [
        "keyword",
        "storage",
        "constant.language",
        "variable.language"
      ],
      "settings": {
        "foreground": "#f92672"
      }
    },
    {
      "name": "control",
      "scope": [
        "keyword.control"
      ],
      "settings": {
        "foreground": "#fd971f"
      }
    },
    {
      "name": "operator",
      "scope": [
        "keyword.operator"
      ],
      "settings": {
        "foreground": "#f92672"
      }
    },
    {
      "name": "variable",
      "scope": [
        "support.variable",
        "variable.parameter"
      ],
      "settings": {
        "foreground": "#66d9ef"
      }
    },
    {
      "name": "filter",
      "scope": [
        "entity.name.type",
        "support.type",
        "support.class"
      ],
      "settings": {
        "foreground": "#a6e22e"
      }
    },
    {
      "name": "function",
      "scope": [
        "entity.name.function",
        "support.function",
        "meta.decorator"
      ],
      "settings": {
        "foreground": "#a6e22e"
      }
    },
    {
      "name": "string",
      "scope": [
        "string",
        "markup.inline.raw"
      ],
      "settings": {
        "foreground": "#e6db74"
      }
    },
    {
      "name": "escape",
      "scope": [
        "constant.character.escape",
        "string.regexp"
      ],
      "settings": {
        "foreground": "#ae81ff"
      }
    },
    {
      "name": "number",
      "scope": [
        "constant.numeric",
        "constant"
      ],
      "settings": {
        "foreground": "#ae81ff"
      }
    },
    {
      "name": "tag",
      "scope": [
        "entity.name.tag",
        "markup.heading"
      ],
      "settings": {
        "foreground": "#f92672"
      }
    },
    {
      "name": "attribute",
      "scope": [
        "entity.other.attribute-name"
      ],
      "settings": {
        "foreground": "#a6e22e",
        "fontStyle": "italic"
      }
    },
    {
      "name": "property",
      "scope": [
        "support.type.property-name"
      ],
      "settings": {
        "foreground": "#66d9ef"
      }
    },
    {
      "name": "link",
      "scope": [
        "markup.underline.link"
      ],
      "settings": {
        "foreground": "#66d9ef",
        "fontStyle": "underline"
      }
    },
    {
      "name": "invalid",
      "scope": [
        "invalid"
      ],
      "settings": {
        "foreground": "#f44747"
      }
    }
  ]
}
